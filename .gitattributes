# Normaliza quebras de linha: LF no repositório e no working copy.
# Importante aqui porque Dockerfiles, nginx.conf e .air.toml são copiados
# para containers Linux, onde CRLF pode quebrar o build/execução.
* text=auto eol=lf

# Scripts do Windows são a exceção: PRECISAM de CRLF, porque o cmd.exe
# pode falhar ao interpretar labels e goto em arquivos salvos com LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários — nunca normalizar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
