# Imagem de desenvolvimento: servidor do Vite com hot reload.
FROM node:22-alpine

WORKDIR /app

# Instala as dependências numa camada própria para aproveitar o cache do
# Docker: só refaz quando o package.json muda.
COPY package.json ./
RUN npm install

EXPOSE 5173

# npm install roda de novo no start porque o bind mount cobre /app — assim as
# dependências ficam corretas mesmo depois de você editar o package.json.
CMD ["sh", "-c", "npm install && npm run dev"]
